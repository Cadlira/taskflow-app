{
  "name": "taskflow-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.21.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck:contracts": "tsc --project tsconfig.contracts.json --noEmit",
    "typecheck:main": "tsc --project tsconfig.main.json --noEmit",
    "typecheck:preload": "tsc --project tsconfig.preload.json --noEmit",
    "typecheck:renderer": "vue-tsc --project tsconfig.renderer.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:main && npm run typecheck:preload && npm run typecheck:renderer && npm run typecheck:tests",
    "test": "vitest run",
    "build": "electron-vite build",
    "icon:win": "node scripts/generate-windows-icon.mjs",
    "package:win": "npm run build && npm run icon:win && electron-builder --win nsis --x64 --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vue/devtools-api": "8.1.5",
    "better-sqlite3": "12.11.1",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@resvg/resvg-js": "2.6.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "build": {
    "appId": "taskflow.app",
    "productName": "TaskFlow App",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "out/**/*",
      "LICENSE"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "npmRebuild": true,
    "nativeRebuilder": "sequential",
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/taskflow.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "TaskFlow App",
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/taskflow.ico",
      "uninstallerIcon": "build/icons/taskflow.ico",
      "artifactName": "TaskFlowApp-${version}-win-x64-Setup.exe"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
